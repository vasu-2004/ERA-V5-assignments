__pycache__/
*.pyc
.pytest_cache/

# Checkpoint weight/optimiser binaries are large (~4MB each) and are fully
# regenerated by `python run_demo.py`. Each checkpoint's state.json IS committed:
# it carries the checkpoint hash, ledger offsets, scheduler/cursor/OPUS state and
# per-parameter hashes, which is the part that evidences recovery and forking.
submission_artifacts/checkpoints/**/*.npz
